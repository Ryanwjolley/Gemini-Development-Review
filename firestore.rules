rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasPermissions (permissions) {
      // have a look at the constants file for a list of the permissions
      return permissions.hasAny(request.auth.token.permissions)
    }
    
    // TESTING MODE: Allow all access for emulators
    // TODO: Restrict these rules for production
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Production rules (commented out for testing):
    // match /{document=**} {
    //   allow read, write: if hasPermissions([0]) // admin
    // }
    // match /users/{userId} {
    //   allow read: if request.auth != null
    // }    
  }
}