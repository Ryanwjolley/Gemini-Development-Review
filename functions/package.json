{
  "name": "functions",
  "version": "2.14.0",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve:emulators": "JDE_LOCAL=true JDE_DB_EMULATOR_ON=true firebase emulators:start --only functions,firestore,auth --import=../emulator-data --export-on-exit=../emulator-data",
    "serve": "JDE_LOCAL=true firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@shared/shared": "file:./shared",
    "axios": "^1.12.2",
    "bluebird": "^3.7.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "nanoid": "^3.3.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-promise": "^6.6.0"
  },
  "private": true
}
